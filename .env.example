# ==============================================================================
# Sejbosejbo Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Core Settings ---
NODE_ENV=production
SITE_URL=http://localhost:3000
HOST_PORT=3000
PORT=3000
SITE_TIMEZONE=Europe/Ljubljana

# --- Security (REQUIRED: set random secrets for production) ---
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# --- Database (PostgreSQL) ---
PGHOST=db
PGPORT=5432
PGUSER=sejbosejbo
PGPASSWORD=sejbosejbopass
PGDATABASE=sejbosejbo
PGPOOL_MAX=10

# --- Frontend Layout ---
# Options: "forum" (booru/forum image grid) or leave empty for classic hero layout
HOMEPAGE_LAYOUT=forum

# --- Media & Uploads ---
# Enable audio & video uploads (requires ffmpeg, included in default Docker image)
ENABLE_MEDIA_UPLOADS=true
IMAGE_UPLOAD_LIMIT_MB=100
MEDIA_UPLOAD_LIMIT_MB=500

# Emergency switches:
# UPLOADS_PAUSED=false
# INPUT_PAUSED=false

# --- Storage Driver (local or s3) ---
STORAGE_DRIVER=local

# S3 Object Storage (Optional: required only if STORAGE_DRIVER=s3)
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_PREFIX=
# S3_PUBLIC_BASE_URL=

# S3 Mirror (Optional: best-effort secondary bucket for redundancy)
# S3_MIRROR_BUCKET=
# S3_MIRROR_ENDPOINT=
# S3_MIRROR_ACCESS_KEY_ID=
# S3_MIRROR_SECRET_ACCESS_KEY=
# S3_MIRROR_REGION=us-east-1
# S3_MIRROR_PREFIX=

# --- AI Quote & Copy Generation (Optional) ---
# AI_PROVIDER: "ollama" | "openai" (leave unset to use built-in static phrases)
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_TIMEOUT_MS=180000

# Hosted OpenAI-compatible example:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- Email / SMTP (Optional: for reports and post notifications) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Push Notifications / Mobile App Integration (Optional) ---
# FCM_SERVICE_ACCOUNT_JSON=
# APPLE_TEAM_ID=
# ANDROID_PACKAGE_NAME=com.thekingziga.sejbosejbo
# ANDROID_CERT_SHA256=

# --- Donations / Tipping (Optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
